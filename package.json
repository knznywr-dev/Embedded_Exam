{
  "name": "embedded-reviewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive study reviewer for the Embedded Systems BSCpE 4 final examination, built only from the attached 11-page reviewer PDF.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.8"
  }
}
